{
  "previewPort": 3000,
  "healthPath": "/",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    {
      "name": "VITE_SUPABASE_URL",
      "description": "Your Supabase project URL (e.g. https://mtfrvdccubwqdnmnudyu.supabase.co)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    },
    {
      "name": "VITE_SUPABASE_ANON_KEY",
      "description": "Your Supabase anon/public API key (found in Supabase Dashboard → Settings → API)",
      "requiredAtBoot": true,
      "generatedForDevelopment": true
    }
  ]
}
